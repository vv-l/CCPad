<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CCPad.TabPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <TabView
            x:Name="Tabs"
            CanReorderTabs="True"
            CanDragTabs="True"
            AllowDropTabs="True"
            TabWidthMode="Equal"
            AddTabButtonClick="OnAddTab"
            TabCloseRequested="OnTabClose"
            SelectionChanged="OnTabSelectionChanged"
            TabDragStarting="OnTabDragStarting"
            TabDragCompleted="OnTabDragCompleted"
            TabStripDragOver="OnTabStripDragOver"
            TabStripDrop="OnTabStripDrop"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <TabView.TabStripFooter>
                <StackPanel Orientation="Horizontal" Padding="0,0,8,0"
                            HorizontalAlignment="Right">
                    <!-- Reserves space for the global WorkspaceButton overlay declared in MainWindow.xaml,
                         so tabs don't extend underneath it. Width is set at runtime to match the
                         button's actual size (it grows with long localized labels). 0 when no workspace. -->
                    <Grid x:Name="WorkspaceReserve" Width="0"/>
                    <DropDownButton x:Name="ProjectButton"
                                    ToolTipService.ToolTip="从项目启动新标签页"
                                    Padding="8,4"
                                    Margin="4,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                            <TextBlock x:Name="ProjectLabel" Text="项目" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="ProjectFlyout" Placement="BottomEdgeAlignedRight"/>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </TabView.TabStripFooter>
        </TabView>

        <Grid x:Name="PrewarmHost"
              Width="1" Height="1" Opacity="0"
              IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- Drag handle: thin strip overlaid on the bottom edge of the tab strip.
             Margin.Top is recalculated from TabHeightManager.Height in code-behind. -->
        <Border x:Name="ResizeHandle"
                Height="6"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                ToolTipService.ToolTip="拖拽调整页签高度 · 双击恢复默认"
                PointerEntered="OnHandlePointerEntered"
                PointerExited="OnHandlePointerExited"
                PointerPressed="OnHandlePointerPressed"
                PointerMoved="OnHandlePointerMoved"
                PointerReleased="OnHandlePointerReleased"
                PointerCaptureLost="OnHandlePointerReleased"
                DoubleTapped="OnHandleDoubleTapped"/>
    </Grid>

</UserControl>
