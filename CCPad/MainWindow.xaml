<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CCPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CCPad"
    mc:Ignorable="d"
    Title="CC Pad">

    <Grid x:Name="RootContainer" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Keep the global bottom controls outside the terminal viewport so
                 the CLI's own status line is never painted underneath them. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Right-docked file manager. Width 0 / collapsed when closed. -->
            <ColumnDefinition x:Name="FilePanelCol" Width="0"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="RootGrid" Grid.Row="0" Grid.Column="0"/>

        <local:FileManagerPanel x:Name="FilePanel" Grid.Row="0" Grid.RowSpan="2"
                                Grid.Column="1" Visibility="Collapsed"/>

        <StackPanel Grid.Row="1" Grid.Column="0"
                    Orientation="Horizontal" Spacing="6"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="8,0,0,8">
        <Button x:Name="QuotaButton" Padding="7,3"
                ToolTipService.ToolTip="Codex usage"
                Click="OnQuotaButtonClick">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="AI" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="QuotaProviderLabel" Text="Codex"
                           FontSize="12" VerticalAlignment="Center"/>
                <ProgressBar x:Name="QuotaProgress" Width="54" Height="5"
                             Minimum="0" Maximum="100" Value="0"
                             VerticalAlignment="Center"/>
                <TextBlock x:Name="QuotaPercentLabel" Text="--"
                           FontSize="11" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas"/>
                <TextBlock x:Name="QuotaResetLabel" Text=""
                           FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
            </StackPanel>
            <Button.Flyout>
                <Flyout x:Name="QuotaFlyout" Placement="TopEdgeAlignedLeft"
                        Opened="OnQuotaFlyoutOpened">
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Width="320" Spacing="9">
                            <ComboBox x:Name="QuotaProviderSelector"
                                      Width="120"
                                      HorizontalAlignment="Left"
                                      SelectedIndex="0"
                                      SelectionChanged="OnQuotaProviderChanged">
                                <ComboBoxItem x:Name="QuotaCodexItem" Content="Codex"/>
                                <ComboBoxItem x:Name="QuotaClaudeItem" Content="Claude"/>
                            </ComboBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Name="QuotaFlyoutTitle" Text="Codex"
                                               FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="QuotaFlyoutPlan" Text=""
                                               FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                                <TextBlock x:Name="QuotaFlyoutUpdated" Grid.Column="1"
                                           Text="" FontSize="11" Opacity="0.65"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar x:Name="QuotaFlyoutProgress" Minimum="0"
                                         Maximum="100" Value="0" Height="7"/>
                            <StackPanel x:Name="QuotaWindowPanel" Spacing="9"/>
                            <TextBlock x:Name="QuotaCreditsLabel" Text=""
                                       FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="QuotaFlyoutStatus" Text=""
                                       TextWrapping="Wrap" FontSize="12" Opacity="0.75"/>
                            <Button x:Name="QuotaRefreshButton" Content="Refresh"
                                    HorizontalAlignment="Right" Padding="12,5"
                                    Click="OnQuotaRefreshClick"/>
                        </StackPanel>
                    </Border>
                </Flyout>
            </Button.Flyout>
        </Button>
        <Button x:Name="ClaudeQuotaButton" Padding="7,3"
                ToolTipService.ToolTip="Claude usage"
                Click="OnClaudeQuotaButtonClick">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="ClaudeQuotaProviderLabel" Text="Claude"
                           FontSize="12" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ClaudeQuotaProgress" Width="54" Height="5"
                             Minimum="0" Maximum="100" Value="0"
                             VerticalAlignment="Center"/>
                <TextBlock x:Name="ClaudeQuotaPercentLabel" Text="--"
                           FontSize="11" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas"/>
                <TextBlock x:Name="ClaudeQuotaResetLabel" Text=""
                           FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        </StackPanel>

        <!-- Update button — global, bottom-right, left of the toggle cluster -->
        <Button x:Name="UpdateButton" Grid.Row="1" Grid.Column="0"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,400,9"
                Padding="6"
                ToolTipService.ToolTip="检查更新"
                Background="Transparent"
                BorderBrush="Transparent"
                Visibility="Collapsed"
                Click="OnUpdateButtonClick">
            <FontIcon Glyph="&#xECC5;" FontSize="14" Foreground="#4CC2FF"/>
        </Button>

        <!-- Bottom-right control cluster: [回车] [寄存] [关于]. Three uniform
             buttons — same control footprint (plain Button shape, no chevron),
             equal width/height, identical icon+label layout, tight spacing. -->
        <StackPanel x:Name="BottomRightCluster" Grid.Row="1" Grid.Column="0"
                    Orientation="Horizontal" Spacing="4"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,8,8">
            <ToggleButton x:Name="LastCmdButton"
                          Width="74" Height="28" MinHeight="28" MinWidth="0"
                          Padding="0" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          ToolTipService.ToolTip="上一条命令信息栏：每个终端顶部显示最近发出的命令（Alt+L 开/关）"
                          Click="OnLastCmdButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE81C;" FontSize="14"/>
                    <TextBlock x:Name="LastCmdButtonLabel" Text="上条" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="FilesButton"
                          Width="74" Height="28" MinHeight="28" MinWidth="0"
                          Padding="0" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          ToolTipService.ToolTip="文件管理器：浏览当前项目目录"
                          Click="OnFilesButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                    <TextBlock x:Name="FilesButtonLabel" Text="文件" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="AutoButton"
                          Width="74" Height="28" MinHeight="28" MinWidth="0"
                          Padding="0" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          ToolTipService.ToolTip="自动回车：AI 弹出确认提示时自动替你按回车"
                          Click="OnAutoButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8FB;" FontSize="14"/>
                    <TextBlock x:Name="AutoButtonLabel" Text="回车" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="ReplyButton"
                          Width="74" Height="28" MinHeight="28" MinWidth="0"
                          Padding="0" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          ToolTipService.ToolTip="自动应答：检测到自定义词条时自动发送预设消息（右键设置规则）"
                          Click="OnReplyButtonClick"
                          RightTapped="OnReplyButtonRightTapped">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8BD;" FontSize="14"/>
                    <TextBlock x:Name="ReplyButtonLabel" Text="应答" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="StageButton"
                          Width="74" Height="28" MinHeight="28" MinWidth="0"
                          Padding="0" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          ToolTipService.ToolTip="命令寄存模式：输入先排队，会话空闲时自动逐条发送"
                          Click="OnStageButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                    <TextBlock x:Name="StageButtonLabel" Text="寄存" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>

            <Button x:Name="FreezeButton"
                    Width="74" Height="28" MinHeight="28" MinWidth="0"
                    Padding="0" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="冻结：关闭后台标签的页面和进程释放内存，点击占位页即可恢复">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE9CA;" FontSize="14"/>
                    <TextBlock x:Name="FreezeButtonLabel" Text="冻结" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="FreezeFlyout" Placement="TopEdgeAlignedRight"/>
                </Button.Flyout>
            </Button>

            <Button x:Name="AboutButton"
                    Width="74" Height="28" MinHeight="28" MinWidth="0"
                    Padding="0" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTipService.ToolTip="关于 / 设置">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE946;" FontSize="14"/>
                    <TextBlock x:Name="AboutButtonLabel" Text="关于" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="AboutFlyout" Placement="TopEdgeAlignedRight"/>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!-- Workspace button — global, top-right, above all split panels -->
        <DropDownButton x:Name="WorkspaceButton" Grid.Row="0" Grid.Column="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,7,100,0"
                        Padding="8,4"
                        ToolTipService.ToolTip="工作区"
                        >
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE8F1;" FontSize="14"/>
                <TextBlock x:Name="WorkspaceLabel" Text="工作区" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <DropDownButton.Flyout>
                <MenuFlyout x:Name="WorkspaceFlyout" Placement="BottomEdgeAlignedRight"/>
            </DropDownButton.Flyout>
        </DropDownButton>

        <!-- Memory-pressure warning — non-modal so it can't wedge the window
             the way a dialog would under the very pressure it warns about -->
        <InfoBar x:Name="ResourceInfoBar" Grid.Row="0" Grid.Column="0"
                 Severity="Warning" IsOpen="False" IsClosable="True"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 MaxWidth="680" Margin="12,40,12,0"/>
    </Grid>

</Window>
