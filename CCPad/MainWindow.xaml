<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CCPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CC Pad">

    <Grid>
        <Grid x:Name="RootGrid"/>

        <!-- Update button — global, bottom-right, left of About -->
        <Button x:Name="UpdateButton"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,58,9"
                Padding="6"
                ToolTipService.ToolTip="检查更新"
                Background="Transparent"
                BorderBrush="Transparent"
                Visibility="Collapsed"
                Click="OnUpdateButtonClick">
            <FontIcon Glyph="&#xECC5;" FontSize="14" Foreground="#4CC2FF"/>
        </Button>

        <!-- About button — global, bottom-right. Always visible (no transparent
             override) so the settings/notification toggles are discoverable. -->
        <DropDownButton x:Name="AboutButton"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,8,8"
                        Padding="6"
                        ToolTipService.ToolTip="关于 / 设置">
            <FontIcon Glyph="&#xE946;" FontSize="14"/>
            <DropDownButton.Flyout>
                <MenuFlyout x:Name="AboutFlyout" Placement="TopEdgeAlignedRight"/>
            </DropDownButton.Flyout>
        </DropDownButton>

        <!-- Workspace button — global, top-right, above all split panels -->
        <DropDownButton x:Name="WorkspaceButton"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,7,100,0"
                        Padding="8,4"
                        ToolTipService.ToolTip="工作区"
                        >
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE8F1;" FontSize="14"/>
                <TextBlock x:Name="WorkspaceLabel" Text="工作区" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <DropDownButton.Flyout>
                <MenuFlyout x:Name="WorkspaceFlyout" Placement="BottomEdgeAlignedRight"/>
            </DropDownButton.Flyout>
        </DropDownButton>
    </Grid>

</Window>
