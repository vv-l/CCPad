<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CCPad.QuotaOverviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Codex quota overview">
    <Grid x:Name="OverviewRoot" Background="{ThemeResource WindowBackgroundBrush}" Padding="20" RowSpacing="14">
        <Grid.Resources>
            <Style x:Key="QuotaOverviewCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="18"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock x:Name="OverviewTitle" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="OverviewSubtitle" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button x:Name="OverviewRefreshButton" Click="OnRefreshAllClick" Padding="14,7"/>
            <Button x:Name="OverviewAddButton" Click="OnAddAccountClick" Padding="14,7"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="OverviewCards" ColumnSpacing="14" RowSpacing="14"
                  HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
        </ScrollViewer>
        <TextBlock x:Name="OverviewStatus" Grid.Row="3" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
    </Grid>
</Window>
