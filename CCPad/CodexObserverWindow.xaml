<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CCPad.CodexObserverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ObserverRoot" Background="{ThemeResource WindowBackgroundBrush}" Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="5">
            <TextBlock x:Name="ObserverTitle" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="SessionText" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" Opacity="0.75"/>
        </StackPanel>
        <InfoBar x:Name="BindingNotice" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational">
            <InfoBar.Content>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="BindingHelp" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="SessionIdBox" Width="330"/>
                        <Button x:Name="BindButton" Click="OnBindClick"/>
                    </StackPanel>
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"/>
            <ToggleButton x:Name="FollowButton" Grid.Column="1" IsChecked="True" Click="OnFollowClick"/>
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="AgentsHeading" FontWeight="SemiBold"/>
                <ListView x:Name="AgentList" Grid.Row="1" SelectionChanged="OnAgentSelected" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="5" Padding="0,7">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TimelineHeading" FontWeight="SemiBold"/>
                <ListView x:Name="TimelineList" Grid.Row="1" SelectionChanged="OnEventSelected" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="3" Padding="0,5">
                                <TextBlock Text="{Binding Caption}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="DetailHeading" Grid.Row="2" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBox x:Name="DetailBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="4" Spacing="4">
            <TextBlock x:Name="MetricsText" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="CoverageText" FontSize="12" TextWrapping="Wrap" Opacity="0.65"/>
        </StackPanel>
    </Grid>
</Window>
